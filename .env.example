# Diagnostic LLM (used by both agents)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# TypeSafe / Jev (chunk relevance scoring)
TYPESAFE_API_KEY=ts-...
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Jev mode: shadow (score only, pass all chunks), live (filter), mock (heuristic)
JEV_MODE=live
RELEVANCE_THRESHOLD=0.65

# Benchmark settings
BENCHMARK_RUNS=3
